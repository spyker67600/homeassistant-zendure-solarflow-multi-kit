{# =====================================================================
   ZENDURE MULTI-KIT — CONSIGNE IDÉALE (macro commune aux 3 kits)
   Fichier : config/custom_templates/zendure_multikit.jinja
   Appelée par les capteurs sensor.zendure_consigne_ideale_kit1/2/3 :
     {% from 'zendure_multikit.jinja' import consigne_zendure %}
     {{ consigne_zendure('kit1') | float(0) | int }}
   Ne rien modifier ici : tous les seuils se règlent dans les helpers
   input_number.zendure_reglage_* (carte "Réglages" du dashboard).
   ===================================================================== #}

{%- macro consigne_zendure(kit) -%}

{#- --- Entités générales --- -#}
{%- set ent_limite_max = 'input_number.zendure_limite_injection_max' -%}
{%- set ent_compteur = 'sensor.zendure_compteur_reseau' -%}
{%- set ent_mode_hiver = 'input_boolean.zendure_mode_hiver' -%}

{#- --- Télémétrie MQTT des kits --- -#}
{%- set cible_minsoc_1 = states('input_number.zendure_cible_min_soc_kit1') | float(10) -%}
{%- set pv_1 = states('sensor.zendure_kit1_solarinputpower') | float(0) -%}
{%- set soc_1 = states('sensor.zendure_kit1_electriclevel') | float(0) -%}
{%- set inj_1 = states('sensor.zendure_kit1_outputhomepower') | float(0) -%}
{%- set ac_1 = states('sensor.zendure_kit1_gridinputpower') | float(0) -%}

{%- set cible_minsoc_2 = states('input_number.zendure_cible_min_soc_kit2') | float(10) -%}
{%- set pv_2 = states('sensor.zendure_kit2_solarinputpower') | float(0) -%}
{%- set soc_2 = states('sensor.zendure_kit2_electriclevel') | float(0) -%}
{%- set inj_2 = states('sensor.zendure_kit2_outputhomepower') | float(0) -%}
{%- set ac_2 = states('sensor.zendure_kit2_gridinputpower') | float(0) -%}

{%- set cible_minsoc_3 = states('input_number.zendure_cible_min_soc_kit3') | float(10) -%}
{%- set pv_3 = states('sensor.zendure_kit3_solarinputpower') | float(0) -%}
{%- set soc_3 = states('sensor.zendure_kit3_electriclevel') | float(0) -%}
{%- set inj_3 = states('sensor.zendure_kit3_outputhomepower') | float(0) -%}
{%- set ac_3 = states('sensor.zendure_kit3_gridinputpower') | float(0) -%}

{%- set pv_tot = pv_1 + pv_2 + pv_3 -%}
{%- set inj_tot = inj_1 + inj_2 + inj_3 -%}
{%- set ac_tot = ac_1 + ac_2 + ac_3 -%}
{%- set reseau = states(ent_compteur) | float(0) -%}
{%- set limite_totale = states(ent_limite_max) | float(800) -%}
{%- set hiver = is_state(ent_mode_hiver, 'on') -%}
{%- set eponge_active = (ac_tot > 0) -%}

{#- --- Réglages (helpers input_number.zendure_reglage_*, valeur par défaut si indisponible) --- -#}
{%- set r_coussin_n = (states('input_number.zendure_reglage_coussin_normal') | float(7)) -%}
{%- set r_coussin_r = (states('input_number.zendure_reglage_coussin_charge_reseau') | float(40)) -%}
{%- set r_marge = (states('input_number.zendure_reglage_marge_soc') | float(2)) -%}
{%- set r_marge_gris = (states('input_number.zendure_reglage_marge_soc_jour_gris') | float(10)) -%}
{%- set r_tampon = (states('input_number.zendure_reglage_tampon_bypass') | float(15)) -%}
{%- set r_nuage = (states('input_number.zendure_reglage_marge_anti_nuage') | float(100)) -%}

{#- --- Déduction hiver : gros consommateurs (capteur du package, déjà filtré par le seuil réglé) --- -#}
{%- set deduction_hiver = (states('sensor.zendure_deduction_hiver') | float(0)) if hiver else 0 -%}

{#- 1. CIBLE MAISON ZÉRO EXPORT -#}
{%- set coussin = r_coussin_r if eponge_active else r_coussin_n -%}
{%- set conso_brute = inj_tot + reseau - ac_tot - coussin -%}
{%- set maison_totale = [conso_brute, 0] | max -%}
{%- set maison_batterie = [conso_brute - deduction_hiver, 0] | max -%}

{#- 2. MODE ET RÔLES -#}
{%- set mode_jour = (pv_tot > 100) -%}
{%- set maitre = states('input_select.zendure_kit_maitre') -%}
{%- set est_maitre_1 = (maitre == 'kit1') -%}
{%- set est_maitre_2 = (maitre == 'kit2') -%}
{%- set est_maitre_3 = (maitre == 'kit3') -%}

{#- 3. STATUTS DES KITS -#}
{%- set jour_1 = (pv_1 > 20) -%}
{%- set jour_2 = (pv_2 > 20) -%}
{%- set jour_3 = (pv_3 > 20) -%}
{%- set prod_suffisante = (maison_totale <= pv_tot) -%}

{#- Jauge BMS suspecte (contrôle de plausibilité) : on ne croit plus son SOC.
    Le kit ne fait que du solaire direct : pas de bypass, pas de sprint,
    pas de décharge batterie, jusqu'au prochain vrai plein (calibrage). -#}
{%- set susp_1 = is_state('input_boolean.zendure_jauge_suspecte_kit1', 'on') -%}
{%- set susp_2 = is_state('input_boolean.zendure_jauge_suspecte_kit2', 'on') -%}
{%- set susp_3 = is_state('input_boolean.zendure_jauge_suspecte_kit3', 'on') -%}

{%- set bat_pleine_1 = is_state('input_boolean.zendure_bypass_kit1', 'on') and not susp_1 -%}
{%- set bat_pleine_2 = is_state('input_boolean.zendure_bypass_kit2', 'on') and not susp_2 -%}
{%- set bat_pleine_3 = is_state('input_boolean.zendure_bypass_kit3', 'on') and not susp_3 -%}

{%- set bypass_1 = bat_pleine_1 and jour_1 and prod_suffisante -%}
{%- set bypass_2 = bat_pleine_2 and jour_2 and prod_suffisante -%}
{%- set bypass_3 = bat_pleine_3 and jour_3 and prod_suffisante -%}

{%- set sprint_1 = (soc_1 | round(0) >= 98) and not susp_1 and not bat_pleine_1 and jour_1 and (pv_1 > 150) -%}
{%- set sprint_2 = (soc_2 | round(0) >= 98) and not susp_2 and not bat_pleine_2 and jour_2 and (pv_2 > 150) -%}
{%- set sprint_3 = (soc_3 | round(0) >= 98) and not susp_3 and not bat_pleine_3 and jour_3 and (pv_3 > 150) -%}

{#- 4. SÉPARATION DU SOLAIRE DIRECT -#}
{%- set pv_utile_1 = pv_1 if not bypass_1 and not sprint_1 else 0 -%}
{%- set pv_utile_2 = pv_2 if not bypass_2 and not sprint_2 else 0 -%}
{%- set pv_utile_3 = pv_3 if not bypass_3 and not sprint_3 else 0 -%}
{%- set pv_utile_tot = pv_utile_1 + pv_utile_2 + pv_utile_3 -%}

{%- set inj_bypass_tot = (pv_1 if bypass_1 else 0) + (pv_2 if bypass_2 else 0) + (pv_3 if bypass_3 else 0) -%}
{%- set besoin_net = [maison_totale - inj_bypass_tot, 0] | max -%}

{#- 5. PARTAGE SOLAIRE (maître puis esclaves au prorata) -#}
{%- set pv_utile_maitre = (pv_utile_1 if est_maitre_1 else 0) + (pv_utile_2 if est_maitre_2 else 0) + (pv_utile_3 if est_maitre_3 else 0) -%}
{%- set pv_utile_esclaves_tot = pv_utile_tot - pv_utile_maitre -%}
{%- set besoin_apres_maitre = [besoin_net - pv_utile_maitre, 0] | max -%}

{%- set r_esc_1 = (pv_utile_1 / pv_utile_esclaves_tot) if pv_utile_esclaves_tot > 0 else 0 -%}
{%- set r_esc_2 = (pv_utile_2 / pv_utile_esclaves_tot) if pv_utile_esclaves_tot > 0 else 0 -%}
{%- set r_esc_3 = (pv_utile_3 / pv_utile_esclaves_tot) if pv_utile_esclaves_tot > 0 else 0 -%}
{%- set r_tot_1 = (pv_utile_1 / pv_utile_tot) if pv_utile_tot > 0 else 0 -%}
{%- set r_tot_2 = (pv_utile_2 / pv_utile_tot) if pv_utile_tot > 0 else 0 -%}
{%- set r_tot_3 = (pv_utile_3 / pv_utile_tot) if pv_utile_tot > 0 else 0 -%}

{%- if mode_jour -%}
  {%- set part_sol_1 = ([besoin_net, pv_utile_1] | min) if est_maitre_1 else ([besoin_apres_maitre * r_esc_1, pv_utile_1] | min) -%}
  {%- set part_sol_2 = ([besoin_net, pv_utile_2] | min) if est_maitre_2 else ([besoin_apres_maitre * r_esc_2, pv_utile_2] | min) -%}
  {%- set part_sol_3 = ([besoin_net, pv_utile_3] | min) if est_maitre_3 else ([besoin_apres_maitre * r_esc_3, pv_utile_3] | min) -%}
{%- else -%}
  {%- set part_sol_1 = [besoin_net * r_tot_1, pv_utile_1] | min -%}
  {%- set part_sol_2 = [besoin_net * r_tot_2, pv_utile_2] | min -%}
  {%- set part_sol_3 = [besoin_net * r_tot_3, pv_utile_3] | min -%}
{%- endif -%}

{#- 6. PARTAGE BATTERIE (anti micro-cyclage, pondération au carré) -#}
{%- set marge_1 = r_marge_gris if (pv_1 > 10 and pv_1 < 100) else r_marge -%}
{%- set marge_2 = r_marge_gris if (pv_2 > 10 and pv_2 < 100) else r_marge -%}
{%- set marge_3 = r_marge_gris if (pv_3 > 10 and pv_3 < 100) else r_marge -%}

{%- set bat_ok_1 = (soc_1 > cible_minsoc_1 + marge_1) and not susp_1 and not bypass_1 and not sprint_1 -%}
{%- set bat_ok_2 = (soc_2 > cible_minsoc_2 + marge_2) and not susp_2 and not bypass_2 and not sprint_2 -%}
{%- set bat_ok_3 = (soc_3 > cible_minsoc_3 + marge_3) and not susp_3 and not bypass_3 and not sprint_3 -%}

{%- set besoin_bat_brut = [maison_batterie - inj_bypass_tot - pv_utile_tot, 0] | max -%}
{%- set besoin_bat = [besoin_bat_brut, limite_totale] | min -%}

{%- set util_1 = ([((soc_1 - cible_minsoc_1) / (100 - cible_minsoc_1) * 100), 0] | max) if cible_minsoc_1 < 100 else 0 -%}
{%- set util_2 = ([((soc_2 - cible_minsoc_2) / (100 - cible_minsoc_2) * 100), 0] | max) if cible_minsoc_2 < 100 else 0 -%}
{%- set util_3 = ([((soc_3 - cible_minsoc_3) / (100 - cible_minsoc_3) * 100), 0] | max) if cible_minsoc_3 < 100 else 0 -%}

{%- set w_1 = (util_1 ** 2) if bat_ok_1 else 0 -%}
{%- set w_2 = (util_2 ** 2) if bat_ok_2 else 0 -%}
{%- set w_3 = (util_3 ** 2) if bat_ok_3 else 0 -%}
{%- set w_tot = w_1 + w_2 + w_3 -%}

{%- set part_bat_1 = (w_1 / w_tot * besoin_bat) if w_tot > 0 else 0 -%}
{%- set part_bat_2 = (w_2 / w_tot * besoin_bat) if w_tot > 0 else 0 -%}
{%- set part_bat_3 = (w_3 / w_tot * besoin_bat) if w_tot > 0 else 0 -%}

{#- 7. CONSIGNE FINALE DU KIT DEMANDÉ -#}
{%- set K = {
  'kit1': {'pv': pv_1, 'bypass': bypass_1, 'sprint': sprint_1, 'sol': part_sol_1, 'bat': part_bat_1},
  'kit2':     {'pv': pv_2, 'bypass': bypass_2, 'sprint': sprint_2, 'sol': part_sol_2, 'bat': part_bat_2},
  'kit3':   {'pv': pv_3, 'bypass': bypass_3, 'sprint': sprint_3, 'sol': part_sol_3, 'bat': part_bat_3}
} -%}
{%- set k = K[kit] -%}
{%- set tampon_bypass = r_tampon -%}
{%- set marge_anti_nuage = r_nuage -%}
{%- set all_bypass = bypass_1 and bypass_2 and bypass_3 -%}

{%- if all_bypass -%}
  {%- set ratio = (k.pv / pv_tot) if pv_tot > 0 else 0 -%}
  {%- set consigne = [(maison_totale * ratio) + marge_anti_nuage, k.pv] | min -%}
{%- elif k.bypass -%}
  {%- set consigne = [k.pv - tampon_bypass, 0] | max -%}
{%- elif k.sprint -%}
  {%- set consigne = 0 -%}
{%- elif k.bat <= 0 -%}
  {#- Batterie non sollicitée : bridé au solaire direct, tampon 5 W anti-latence -#}
  {%- set consigne = [k.sol, [k.pv - 5, 0] | max] | min -%}
{%- else -%}
  {%- set consigne = k.sol + k.bat -%}
{%- endif -%}

{{- ([consigne, 800] | min) | round(0) -}}
{%- endmacro -%}
